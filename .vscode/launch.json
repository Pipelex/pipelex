    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug check",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "--help",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug test without inference",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-vv",
                "-k test_compose_image_content_multiple"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug test inference LLM structured",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-vv",
                "-m inference",
                "-k test_pipe_llm_structured"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug test inference Img Gen",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-vv",
                "-m inference",
                "-k test_img_gen_single_opaque"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug test inference PipeExtract",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-vv",
                "-m inference",
                "-k test_pipe_extract_from_pdf"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug validate bundle",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "validate",
                "temp/bundle.mthds",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug validate pipe",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "validate",
                "analyze_image_collection",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug run bundle no inputs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "run",
                "bundle",
                "tests/integration/pipelex/pipes/pipelines/test_image_out_in.mthds",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug run pipe from bundle with inputs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "run",
                "bundle",
                "tests/integration/pipelex/pipes/pipelines/test_image_out_in.mthds",
                "--pipe",
                "describe_image",
                "--inputs",
                "tests/data/pipeline_inputs/input_image.json",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug run pipe code",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/pipelex",
            "args": [
                "run",
                "pipe",
                "write_discord_newsletter",
                "--inputs",
                "tests/data/discord_newsletter/discord_sample_input.json",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}