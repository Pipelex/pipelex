domain      = "supplier_invoices"
description = "Acknowledging a supplier invoice by the amount it asks for"
main_pipe   = "acknowledge_invoice"

[concept.InvoiceLine]
description = "One line of an invoice"

[concept.InvoiceLine.structure]
amount = { type = "number", description = "What the line costs, in euros", required = true }

[concept.Invoice]
description = "An invoice received from a supplier"

[concept.Invoice.structure]
total         = { type = "number", description = "The amount due, in euros", required = true }
lines         = { type = "list", item_type = "concept", item_concept_ref = "InvoiceLine", description = "The lines of the invoice", required = true }
order_details = { type = "dict", key_type = "text", value_type = "text", description = "The references the supplier printed for the order", required = true }

[pipe.write_receipt]
type        = "PipeCompose"
description = "Writes the receipt for an amount"
inputs      = { total_amount = "Number" }
output      = "Text"
template    = "Received: $total_amount euros"

[pipe.acknowledge_invoice]
type        = "PipeSequence"
description = "Binds the total of an invoice, then writes the note"
inputs      = { invoice = "Invoice" }
output      = "Text"
# Wrong on purpose: `invoice.total` binds a Number, which `write_note` reads as Text.
steps = [
  { from = "invoice.total", result = "total_amount" },
  { pipe = "write_note", result = "note" },
]

[pipe.write_note]
type        = "PipeCompose"
description = "Writes a note about an amount written out in words"
inputs      = { total_amount = "Text" }
output      = "Text"
template    = "Amount in words: $total_amount"
