domain      = "shop_hours"
description = "Turning the opening hours written on a shop door into fields"
main_pipe   = "read_opening_hours"

[concept.OpeningHours]
description = "The hours a shop is open on a given day"

[concept.OpeningHours.structure]
day    = { type = "text", description = "The day of the week the hours apply to", required = true }
opens  = { type = "text", description = "The time the shop opens, as written on the door", required = true }
closes = { type = "text", description = "The time the shop closes, as written on the door", required = true }

[pipe.read_opening_hours]
type        = "PipeStructure"
description = "Reads a line of opening hours off a shop door and fills in the fields"
inputs      = { door_notice = "Text" }
output      = "OpeningHours"
