domain      = "facts_examples_on_enumeration"
description = "A river-level card giving examples to an enumeration field"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
level = { description = "The level", choices = [
  "low",
  "high",
], examples = [
  "low",
] }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
