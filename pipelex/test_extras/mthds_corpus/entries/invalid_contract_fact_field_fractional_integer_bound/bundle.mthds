domain      = "facts_fractional_integer_bound"
description = "A tasting card bounding an integer field with a fraction"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
score = { type = "integer", description = "The score", minimum = 1.5 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
