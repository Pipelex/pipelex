domain      = "facts_empty_range"
description = "A tasting card whose score range holds no value"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
score = { type = "integer", description = "The score", minimum = 5, maximum = 1 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
