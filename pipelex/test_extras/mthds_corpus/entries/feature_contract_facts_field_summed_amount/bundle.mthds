domain      = "facts_summed_amount"
description = "A collection card whose amounts add up across cards"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
amount = { type = "number", description = "The amount", unit = "EUR", aggregate = "sum" }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
