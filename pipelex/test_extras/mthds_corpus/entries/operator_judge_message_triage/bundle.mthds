domain      = "message_triage"
description = "Triaging an inbox message with several questions asked in one judgment"
main_pipe   = "triage_message"

[concept.Team]
description = "The team that handles a message"
refines     = "Choice"

[concept.MessageTriage]
description = "What a triage of an inbox message found"

[concept.MessageTriage.structure]
urgent   = { type = "concept", concept_ref = "YesNo", description = "Whether the message needs an answer today", required = true }
team     = { type = "concept", concept_ref = "Team", description = "The team that should handle the message", required = true }
severity = { type = "concept", concept_ref = "Rating", description = "How severe the problem the message reports is" }

[pipe.triage_message]
type = "PipeJudge"
description = "Triages a message: whether it is urgent, which team handles it, and how severe its problem is"
inputs = { message = "Text" }
output = "MessageTriage"
model = "@default-judgment"
prompt = """
A message from someone writing to the inbox:
@message
"""

[pipe.triage_message.questions.urgent]
question  = "Does this message need an answer today?"
criteria  = { yes = "Something is broken or blocked for the sender right now", no = "The sender can wait for a reply" }
threshold = 0.7

[pipe.triage_message.questions.team]
question = "Which team should handle this message?"
options  = { billing = "Charges, invoices, refunds and subscriptions", technical = "Errors, outages and features that do not work", other = "" }

[pipe.triage_message.questions.severity]
question = "How severe is the problem this message reports?"
levels = [
  { label = "Minor", description = "Nothing stops working" },
  { label = "Major", description = "A workaround exists" },
  { label = "Blocking", description = "The sender cannot do their work at all" },
]
