domain      = "filename_undeclared_input"
description = "Drawing a cover whose file name reads an input the pipe does not declare"
main_pipe   = "draw_cover"

[pipe.draw_cover]
type            = "PipeImgGen"
description     = "Draw the cover for the topic"
inputs          = { topic = "Text" }
output          = "Image"
prompt          = "A warm watercolour cover about $topic"
output_filename = "{{ client }} cover"
