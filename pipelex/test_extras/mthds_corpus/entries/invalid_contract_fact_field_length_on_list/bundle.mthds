domain      = "facts_length_on_list"
description = "A library card putting a length on a list field"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
tags = { type = "list", item_type = "text", description = "The tags", max_length = 20 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
