domain      = "facts_both_lower_bounds"
description = "A tasting card stating both an inclusive and an exclusive lower bound"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
score = { type = "number", description = "The score", minimum = 0, exclusive_minimum = 0 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
