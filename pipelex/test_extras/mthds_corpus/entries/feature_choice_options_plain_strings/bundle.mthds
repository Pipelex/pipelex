domain      = "options_plain_strings"
description = "An account card choosing a tier among plain options"
main_pipe   = "draft_card"

[concept.Card]
description = "A client account card"

[concept.Card.structure]
tier = { description = "The account tier", choices = ["strategic", "tactical"] }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
