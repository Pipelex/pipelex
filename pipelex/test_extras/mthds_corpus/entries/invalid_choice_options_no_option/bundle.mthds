domain      = "options_no_option"
description = "An account card offering no option at all"
main_pipe   = "draft_card"

[concept.Card]
description = "A client account card"

[concept.Card.structure]
tier = { description = "The tier", choices = [] }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
