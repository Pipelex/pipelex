domain      = "options_empty_table_value"
description = "An account card whose option table's value is empty"
main_pipe   = "draft_card"

[concept.Card]
description = "A client account card"

[concept.Card.structure]
tier = { description = "The tier", choices = [{ value = "" }] }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
