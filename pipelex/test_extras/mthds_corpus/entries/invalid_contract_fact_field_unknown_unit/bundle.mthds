domain      = "facts_unknown_unit"
description = "A parcel card naming a unit the language does not list"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
weight = { type = "number", description = "The weight", unit = "pounds" }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
