domain      = "facts_minimum_on_text"
description = "A tasting card that puts a numeric bound on a text field"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
score = { type = "text", description = "The score", minimum = 1 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
