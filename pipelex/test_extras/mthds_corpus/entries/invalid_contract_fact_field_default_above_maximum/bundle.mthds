domain      = "facts_default_above_maximum"
description = "A shoe-rack card whose default size breaks its maximum"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
size = { type = "integer", description = "The size", maximum = 10, default_value = 12 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
