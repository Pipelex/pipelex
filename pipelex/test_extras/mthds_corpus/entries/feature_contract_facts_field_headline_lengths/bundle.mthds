domain      = "facts_headline_lengths"
description = "A village notice whose headline holds between one and a hundred and twenty characters"
main_pipe   = "draft_card"

[concept.Card]
description = "A card a desk fills in"

[concept.Card.structure]
headline = { type = "text", description = "The notice headline", min_length = 1, max_length = 120 }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
