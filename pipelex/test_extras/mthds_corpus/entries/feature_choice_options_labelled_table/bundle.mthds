domain      = "options_labelled_table"
description = "An account card whose options carry a label"
main_pipe   = "draft_card"

[concept.Card]
description = "A client account card"

[concept.Card.structure]
tier = { description = "The account tier", choices = [
  { value = "strategic", label = "Strategic" },
  "tactical",
] }

[pipe.draft_card]
type        = "PipeLLM"
description = "Draft the card from the brief"
inputs      = { brief = "Text" }
output      = "Card"
prompt      = "Draft the card from this brief: $brief"
