        "instructor/fireworks_tools",
        "instructor/genai_structured_outputs",
        "instructor/genai_tools",
        "instructor/json",
        "instructor/json_schema",
        "instructor/md_json",
        "instructor/mistral_structured_outputs",
        "instructor/mistral_tools",
        "instructor/openai_json_o1",
        "instructor/openai_parallel_tools",
        "instructor/openai_responses_tools",
        "instructor/openai_responses_tools_with_inbuilt_tools",
        "instructor/openai_structured_outputs",
        "instructor/openai_tools",
        "instructor/openrouter_structured_outputs",
