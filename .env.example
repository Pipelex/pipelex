# The hosted Pipelex API: `pipelex run --hosted` (or `[run] execution = "hosted"`) runs on it with this key alone,
# no provider key needed. `pipelex login` gets one through your browser and saves it to ~/.pipelex/.env; set it here
# only to use another key in this directory, since this file is loaded after that one and wins, even when left empty.
# PIPELEX_API_KEY=
# Override the hosted API's origin (scheme://host[:port]), for a staging plane or a self-hosted Pipelex API server;
# unset means https://api.pipelex.com, and --base-url on the command overrides it in turn.
# PIPELEX_BASE_URL=https://api.pipelex.com

# OpenAI: to use models like GPT-4o and GPT-5
OPENAI_API_KEY=

# Azure: to use models like GPT-4o and GPT-5 from OpenAI but on Azure cloud
AZURE_API_BASE=
AZURE_API_VERSION=
AZURE_API_KEY=

# AWS Bedrock - To use models via Amazon Bedrock: supports Claude models and many open-source models
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# To use Claude models directly from their creator, Anthropic 
ANTHROPIC_API_KEY=

# To use MiniMax models
MINIMAX_API_KEY=

# To use Mistral models
MISTRAL_API_KEY=

# To generate images from fal.ai, the service of Forest Labs
FAL_API_KEY=

# Google AI Studio - Use GOOGLE_API_KEY for direct API access (simpler, rate-limited)
GOOGLE_API_KEY=

# Google Cloud Platform (GCP) - Use these for production Vertex AI access (requires GCP project setup)
# We recomment to use GOOGLE_API_KEY OR GCP credentials, not both
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_CREDENTIALS_FILE_PATH=gcp_credentials.json

# To use Grok from x.ai
XAI_API_KEY=
XAI_API_ENDPOINT=https://api.x.ai/v1/

# Gateways that support various models:
HF_TOKEN=
BLACKBOX_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

SCALEWAY_ENDPOINT=
SCALEWAY_API_KEY=

# Langfuse for observability and evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Web Search & Fetch
LINKUP_API_KEY=

# Judgment
TYPESAFE_API_KEY=
