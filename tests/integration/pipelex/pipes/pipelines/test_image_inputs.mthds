domain      = "test_image_inputs"
description = "Test domain for verifying image input functionality"

[concept]
Article = "Article"

[pipe]
[pipe.extract_article_from_image]
type = "PipeLLM"
description = "Describe a page content"
inputs = { image = "Image" }
output = "Article"
system_prompt = """
You are an expert at describing page contents.
"""
prompt = """
Extract the full text (all the text that represents a "title") and the year of the article in the image.
$image
"""

[pipe.describe_page]
type = "PipeLLM"
description = "Describe a page"
inputs = { "page.page_view" = "Image", page = "Page" }
output = "Article"
system_prompt = """
You are an expert at describing page contents.
"""
prompt = """
Extract the year and title.

@page.page_view

Also, add this to the description:
$page.text_and_images.text.text
"""

# Fed a data-URL image by test_image_inputs_inference.py. It used to borrow `describe_image` from
# the image round-trip bundle that now lives in the corpus; the pipe belongs here, beside the other
# image-input pipes that test drives.
[pipe.describe_image]
type = "PipeLLM"
description = "Describe what is in the image"
inputs = { image = "Image" }
output = "Text"
model = "$vision-cheap"
prompt = """
Describe what you see in this image in 1-2 sentences, be concise.
$image
"""
