domain      = "per_handle_routing_test"
description = "Two LLM calls using distinct concrete model handles, exercising by_handle routing"

[pipe]
[pipe.per_handle_routing_sequence]
type = "PipeSequence"
description = "Step 1 dispatched to claude-4.6-sonnet, step 2 dispatched to gemini-flash-latest"
output = "Text"
steps = [
  { pipe = "step_handle_a", result = "step_handle_a_result" },
  { pipe = "step_handle_b", result = "step_handle_b_result" },
]

[pipe.step_handle_a]
type        = "PipeLLM"
description = "Dispatches via handle_a (claude-4.6-sonnet) — routes to q_handle_a"
output      = "Text"
model       = "claude-4.6-sonnet"
prompt      = "Write a single short sentence about the color blue."

[pipe.step_handle_b]
type = "PipeLLM"
description = "Dispatches via handle_b (gemini-flash-latest) — routes to q_handle_b"
inputs = { step_handle_a_result = "Text" }
output = "Text"
model = "gemini-flash-latest"
prompt = """
Rewrite the following text in a formal tone:

@step_handle_a_result.text
"""
