domain      = "pipe_conflict_beta"
description = "PipeSequence with beta_shared_step PipeLLM about animals — tests per-workflow pipe_ref isolation"

[pipe]
[pipe.pipe_beta_pipeline]
type = "PipeSequence"
description = "Two-step pipeline about animals"
output = "Text"
steps = [
  { pipe = "beta_shared_step", result = "step_result" },
  { pipe = "beta_finalize", result = "final_result" },
]

[pipe.beta_shared_step]
type        = "PipeLLM"
description = "Generate text about animals"
output      = "Text"
model       = "$testing-text"
prompt      = "List three farm animals in a single sentence."

[pipe.beta_finalize]
type = "PipeLLM"
description = "Finalize the animal text"
inputs = { step_result = "Text" }
output = "Text"
model = "$testing-text"
prompt = """
Rewrite this text in a formal tone:

@step_result.text
"""
