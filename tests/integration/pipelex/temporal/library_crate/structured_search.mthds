domain      = "structured_search_test"
description = "Single PipeSearch step over a custom structured TopicSummary concept (exercises act_search_gen_structured across the Temporal boundary)"

[concept.TopicSummary]
description = "A structured summary of web-search findings for a topic"

[concept.TopicSummary.structure]
title      = { type = "text", description = "Topic title", required = true }
summary    = { type = "text", description = "Summary of the findings", required = true }
key_points = { type = "list", item_type = "text", description = "Key points distilled from the search", required = true }

[pipe.structured_search]
type        = "PipeSearch"
description = "Search the web and return a structured TopicSummary"
output      = "TopicSummary"
prompt      = "Summarize the latest developments in AI safety research."
