domain      = "temporal_compose_test"
description = "PipeCompose operator within a PipeSequence for Temporal testing with deferred hydration"

[concept.Report]
description = "A simple report with title and body"

[concept.Report.structure]
title = { type = "text", required = true, description = "Report title" }
body  = { type = "text", required = true, description = "Report body" }

[pipe]
[pipe.temporal_compose_sequence]
type = "PipeSequence"
description = "Generate title and body then compose into a Report"
output = "Report"
steps = [
  { pipe = "generate_title", result = "title_text" },
  { pipe = "generate_body", result = "body_text" },
  { pipe = "compose_report", result = "final_report" },
]

[pipe.generate_title]
type        = "PipeLLM"
description = "Generate a report title"
output      = "Text"
model       = "$testing-text"
prompt      = "Output exactly: Quarterly Review"

[pipe.generate_body]
type        = "PipeLLM"
description = "Generate a report body"
output      = "Text"
model       = "$testing-text"
prompt      = "Output exactly: Revenue increased by 15 percent."

[pipe.compose_report]
type        = "PipeCompose"
description = "Compose title and body into a structured Report"
inputs      = { title_text = "Text", body_text = "Text" }
output      = "Report"

[pipe.compose_report.construct]
title = { from = "title_text.text" }
body  = { from = "body_text.text" }
