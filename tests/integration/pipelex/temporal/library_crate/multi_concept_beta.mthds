domain      = "multi_beta"
description = "PipeSequence with Profile(title,department,level) and Summary(content) — conflicts with alpha's Profile and Summary"

[concept.Profile]
description = "A professional profile with title, department, and level"

[concept.Profile.structure]
title      = { type = "text", required = true, description = "Job title" }
department = { type = "text", required = true, description = "Department name" }
level      = { type = "integer", required = true, description = "Seniority level" }

[concept.Summary]
description = "A compact summary with just content"

[concept.Summary.structure]
content = { type = "text", required = true, description = "Summary content" }

[pipe]
[pipe.multi_beta_pipeline]
type = "PipeSequence"
description = "Three-step pipeline: generate professional Profile, then Summary, then multi_beta_finalize as Text"
output = "Text"
steps = [
  { pipe = "multi_beta_generate_profile", result = "profile_result" },
  { pipe = "multi_beta_generate_summary", result = "summary_result" },
  { pipe = "multi_beta_finalize", result = "final_result" },
]

[pipe.multi_beta_generate_profile]
type        = "PipeLLM"
description = "Generate a professional profile"
output      = "Profile"
model       = "$testing-text"
prompt      = "Generate a profile with title='Engineer', department='Platform', level=3. Respond with exactly those values."

[pipe.multi_beta_generate_summary]
type = "PipeLLM"
description = "Summarize the professional profile"
inputs = { profile_result = "Profile" }
output = "Summary"
model = "$testing-text"
prompt = """
Create a one-line summary for this employee:
Title: $profile_result.title
Department: $profile_result.department
Level: $profile_result.level
"""

[pipe.multi_beta_finalize]
type = "PipeLLM"
description = "Finalize as plain text"
inputs = { summary_result = "Summary" }
output = "Text"
model = "$testing-text"
prompt = """
Format this summary as plain text:
@summary_result.content
"""
