domain      = "temporal_combined_test"
description = "Combined PipeParallel + PipeCondition in a PipeSequence for nested Temporal dispatch testing"

[concept.QualityReport]
description = "A quality assessment report"

[concept.QualityReport.structure]
assessment = { type = "text", required = true, description = "Quality assessment" }
confidence = { type = "text", required = true, description = "Confidence level" }

[concept]
PartContent = "Content generated by a parallel branch"

[pipe]
[pipe.temporal_combined_pipeline]
type = "PipeSequence"
description = "Combines parallel and condition dispatch patterns"
output = "QualityReport"
steps = [
  { pipe = "parallel_generate", result = "parallel_done" },
  { pipe = "quality_gate", result = "gate_result" },
  { pipe = "produce_report", result = "final_report" },
]

[pipe.parallel_generate]
type = "PipeParallel"
description = "Generate two pieces of content in parallel"
output = "Text"
add_each_output = true
branches = [
  { pipe = "generate_part_a", result = "part_a" },
  { pipe = "generate_part_b", result = "part_b" },
]

[pipe.generate_part_a]
type        = "PipeLLM"
description = "Generate part A"
output      = "PartContent"
model       = "$testing-text"
prompt      = "Output exactly: Part A content"

[pipe.generate_part_b]
type        = "PipeLLM"
description = "Generate part B"
output      = "PartContent"
model       = "$testing-text"
prompt      = "Output exactly: Part B content"

[pipe.quality_gate]
type                = "PipeCondition"
description         = "Quality check on generated content"
output              = "Text"
expression_template = "pass"
default_outcome     = "handle_failure"

[pipe.quality_gate.outcomes]
pass = "continue"

[pipe.handle_failure]
type        = "PipeLLM"
description = "Handle quality check failure"
output      = "Text"
model       = "$testing-text"
prompt      = "Output exactly: quality_failed"

[pipe.produce_report]
type = "PipeLLM"
description = "Produce the final quality report"
inputs = { part_a = "PartContent", part_b = "PartContent" }
output = "QualityReport"
model = "$testing-text"
prompt = """
Create a quality report from:
Part A: @part_a
Part B: @part_b
"""
