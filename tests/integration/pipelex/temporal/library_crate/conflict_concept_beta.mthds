domain      = "conflict_beta"
description = "PipeSequence with concept 'Result' having value+confidence+is_valid fields (conflicts with alpha's Result)"

[concept.Result]
description = "A confidence-rated result with validity"

[concept.Result.structure]
value      = { type = "text", required = true, description = "The result value" }
confidence = { type = "number", required = true, description = "Confidence score 0-1" }
is_valid   = { type = "text", required = true, description = "Whether the result is valid" }

[pipe]
[pipe.beta_pipeline]
type = "PipeSequence"
description = "Two-step pipeline producing a confidence-rated Result then summarizing it"
output = "Text"
steps = [
  { pipe = "beta_generate", result = "beta_result" },
  { pipe = "beta_summarize", result = "beta_summary" },
]

[pipe.beta_generate]
type        = "PipeLLM"
description = "Generate a confidence-rated result"
output      = "Result"
model       = "$testing-text"
prompt      = "Generate a result with value='positive', confidence=0.95, is_valid='true'. Respond with exactly those values."

[pipe.beta_summarize]
type = "PipeLLM"
description = "Summarize the confidence-rated result"
inputs = { beta_result = "Result" }
output = "Text"
model = "$testing-text"
prompt = """
Summarize this result:
Value: @beta_result.value
Confidence: @beta_result.confidence
Valid: @beta_result.is_valid
"""
