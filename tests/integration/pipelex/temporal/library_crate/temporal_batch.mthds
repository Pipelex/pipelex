domain      = "temporal_batch_test"
description = "PipeBatch within a PipeSequence for Temporal fan-out child workflow dispatch testing"

[concept]
Topic     = "A subject for content generation"
TopicNote = "A short note about a topic"

[pipe]
[pipe.temporal_batch_sequence]
type = "PipeSequence"
description = "Generate topics then process each via batch"
output = "TopicNote[]"
steps = [
  { pipe = "temporal_generate_topics", result = "topics" },
  { pipe = "batch_temporal_describe_topics", result = "notes" },
]

[pipe.temporal_generate_topics]
type        = "PipeLLM"
description = "Generate a list of topics"
output      = "Topic[3]"
model       = "$testing-text"
prompt      = "List exactly 3 topics: science, history, music"

[pipe.batch_temporal_describe_topics]
type             = "PipeBatch"
description      = "Describe each topic via fan-out child workflows"
inputs           = { topics = "Topic[]" }
output           = "TopicNote[]"
branch_pipe_code = "temporal_describe_topic"
input_list_name  = "topics"
input_item_name  = "topic"

[pipe.temporal_describe_topic]
type        = "PipeLLM"
description = "Write a short note about a topic"
inputs      = { topic = "Topic" }
output      = "TopicNote"
model       = "$testing-text"
prompt      = "Write one sentence about: $topic"
