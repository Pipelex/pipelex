domain      = "pipe_conflict_alpha"
description = "PipeSequence with alpha_shared_step PipeLLM about colors — tests per-workflow pipe_ref isolation"

[pipe]
[pipe.pipe_alpha_pipeline]
type = "PipeSequence"
description = "Two-step pipeline about colors"
output = "Text"
steps = [
  { pipe = "alpha_shared_step", result = "step_result" },
  { pipe = "alpha_finalize", result = "final_result" },
]

[pipe.alpha_shared_step]
type        = "PipeLLM"
description = "Generate text about colors"
output      = "Text"
model       = "$testing-text"
prompt      = "List three primary colors in a single sentence."

[pipe.alpha_finalize]
type = "PipeLLM"
description = "Finalize the color text"
inputs = { step_result = "Text" }
output = "Text"
model = "$testing-text"
prompt = """
Rewrite this text in uppercase:

@step_result.text
"""
