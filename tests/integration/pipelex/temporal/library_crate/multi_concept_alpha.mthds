domain      = "multi_alpha"
description = "PipeSequence with Profile(name,age) and Summary(headline,body) — conflicts with beta's Profile and Summary"

[concept.Profile]
description = "A personal profile with name and age"

[concept.Profile.structure]
name = { type = "text", required = true, description = "Person's name" }
age  = { type = "integer", required = true, description = "Person's age" }

[concept.Summary]
description = "A summary with headline and body"

[concept.Summary.structure]
headline = { type = "text", required = true, description = "Summary headline" }
body     = { type = "text", required = true, description = "Summary body text" }

[pipe]
[pipe.multi_alpha_pipeline]
type = "PipeSequence"
description = "Three-step pipeline: generate personal Profile, then Summary, then multi_alpha_finalize as Text"
output = "Text"
steps = [
  { pipe = "multi_alpha_generate_profile", result = "profile_result" },
  { pipe = "multi_alpha_generate_summary", result = "summary_result" },
  { pipe = "multi_alpha_finalize", result = "final_result" },
]

[pipe.multi_alpha_generate_profile]
type        = "PipeLLM"
description = "Generate a personal profile"
output      = "Profile"
model       = "$testing-text"
prompt      = "Generate a profile with name='Alice' and age=30. Respond with exactly those values."

[pipe.multi_alpha_generate_summary]
type = "PipeLLM"
description = "Summarize the profile"
inputs = { profile_result = "Profile" }
output = "Summary"
model = "$testing-text"
prompt = """
Create a summary for this person:
Name: @profile_result.name
Age: @profile_result.age

Respond with a headline and body.
"""

[pipe.multi_alpha_finalize]
type = "PipeLLM"
description = "Finalize as plain text"
inputs = { summary_result = "Summary" }
output = "Text"
model = "$testing-text"
prompt = """
Format this summary as plain text:
Headline: @summary_result.headline
Body: @summary_result.body
"""
