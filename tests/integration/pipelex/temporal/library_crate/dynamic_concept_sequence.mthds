domain      = "dynamic_concept_test"
description = "PipeSequence with dynamic concept (inline structure) for deferred hydration tests"

[concept.Greeting]
description = "A greeting with message and language"

[concept.Greeting.structure]
message  = { type = "text", required = true, description = "The greeting message" }
language = { type = "text", required = true, description = "The language of the greeting" }

[pipe]
[pipe.dynamic_greeting_sequence]
type = "PipeSequence"
description = "Two-step pipeline producing a dynamic Greeting concept"
output = "Text"
steps = [
  { pipe = "generate_greeting", result = "greeting_result" },
  { pipe = "summarize_greeting", result = "summary_result" },
]

[pipe.generate_greeting]
type        = "PipeLLM"
description = "Generate a greeting in a specific language"
output      = "Greeting"
model       = "$testing-text"
prompt      = "Generate a greeting in French. Respond with exactly: message='Bonjour le monde', language='French'"

[pipe.summarize_greeting]
type = "PipeLLM"
description = "Summarize the greeting"
inputs = { greeting_result = "Greeting" }
output = "Text"
model = "$testing-text"
prompt = """
Summarize this greeting:
Message: $greeting_result.message
Language: $greeting_result.language
"""
