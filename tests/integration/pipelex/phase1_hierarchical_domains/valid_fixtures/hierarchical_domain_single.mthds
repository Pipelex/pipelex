domain      = "legal"
description = "Single-segment domain baseline"

[concept]
ContractClause = "A clause in a legal contract"

[pipe]
[pipe.extract_clause]
type        = "PipeLLM"
description = "Extract a clause from a contract"
inputs      = { contract = "Text" }
output      = "ContractClause"
model       = "$quick-reasoning"
prompt      = "Extract the clause from $contract"
