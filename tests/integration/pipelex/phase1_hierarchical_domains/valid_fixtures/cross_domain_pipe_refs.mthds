domain      = "orchestration"
description = "Orchestration domain using cross-domain pipe references"

[pipe]
[pipe.orchestrate]
type = "PipeSequence"
description = "Orchestrate scoring via cross-domain pipe ref"
inputs = { data = "Text" }
output = "scoring.WeightedScore"
steps = [
  { pipe = "scoring.compute_score", result = "score" },
]
