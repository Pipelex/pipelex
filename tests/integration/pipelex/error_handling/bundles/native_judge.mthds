domain      = "native_judge_test"
description = "Single PipeJudge step over a fixed evidence and a fixed question (no dynamic classes)"

[pipe.native_judge]
type        = "PipeJudge"
description = "Judge whether a fixed claim holds"
output      = "YesNo"
model       = "jev-1.13.0"
prompt      = "A weather report: the sky over Brest is cloudless this afternoon."
question    = "Is the sky blue over Brest this afternoon?"
