{
  "description": "The usage-statistics contract in machine-readable form: the source of truth for specs/usage-statistics.md's generated tables, the PostHog gate generated from it, and every emitter's typed events. Emitters vendor it byte-identical; conformance/scripts/check-usage-statistics-schema.py gates the copies.",
  "spec": "conformance/specs/usage-statistics.md",
  "schema_version": 1,
  "destination": {
    "project": "Open-source usage",
    "region": "eu",
    "capture_host": "https://eu.i.posthog.com",
    "batch_path": "/batch/",
    "project_token": "phc_uQjSVbzNPJxA8bHxfevn7NMzB6PbC6aJQRB6ka6MxT7a"
  },
  "notice": {
    "version": 1,
    "details_url": "https://docs.pipelex.com/latest/setup/usage-statistics/",
    "text": "Pipelex collects anonymous usage statistics: counts of commands, runs, pipe types, models and tokens, and the country your IP address maps to; the address itself is never stored. It never collects your methods, prompts, inputs, outputs, file names or pipe names. To turn it off, run `{disable_command}` or set DO_NOT_TRACK=1. Details: {details_url}",
    "disable_commands": {
      "pipelex": "pipelex usage-stats disable",
      "plxt": "plxt usage-stats disable",
      "vscode-pipelex": "Pipelex: Disable Usage Statistics",
      "mthds": "mthds telemetry disable"
    }
  },
  "patterns": {
    "release_version": {
      "regex": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}([.-]?(a|b|rc|alpha|beta|dev|post|insider)[.]?[0-9]{0,4})?$",
      "max_length": 32,
      "description": "A released version: three numeric components and at most one pre-release, development or post-release tag from a closed set."
    },
    "language_runtime": {
      "regex": "^(python-[0-9]{1,2}\\.[0-9]{1,3}|node-[0-9]{1,3})$",
      "max_length": 16,
      "description": "A language runtime and its version: major and minor for Python, such as `python-3.13`, major only for Node, such as `node-22`."
    },
    "model_handle": {
      "regex": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$",
      "max_length": 96,
      "description": "A model's name as a shipped backend table names it, or `other`."
    },
    "installation_id": {
      "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "max_length": 36,
      "description": "A random UUID version 4 in its canonical lowercase form."
    },
    "ip_address": {
      "regex": "^[0-9A-Fa-f.:]{2,45}$",
      "max_length": 45,
      "description": "An IPv4 or IPv6 address as PostHog's capture writes it."
    },
    "country_code": {
      "regex": "^[A-Z]{2}$",
      "max_length": 2,
      "description": "An ISO 3166-1 alpha-2 country code."
    },
    "country_name": {
      "regex": "^[^\\x00-\\x1f]{1,64}$",
      "max_length": 64,
      "description": "A country's English name as PostHog's GeoIP database gives it."
    },
    "event_uuid": {
      "regex": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
      "max_length": 36,
      "description": "An event's UUID: the version 4 the sender drew, or the one PostHog assigns to an event that came without one."
    },
    "event_timestamp": {
      "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:?[0-9]{2})?$",
      "max_length": 40,
      "description": "An RFC 3339 date and time, such as `2026-10-11T09:30:00.123Z`, as the sender wrote it or PostHog normalised it."
    }
  },
  "envelope": {
    "fields": {
      "distinct_id": {
        "pattern": "installation_id",
        "description": "The installation identifier."
      },
      "uuid": {
        "pattern": "event_uuid",
        "description": "Drawn when the event is created and kept by every resend."
      },
      "timestamp": {
        "pattern": "event_timestamp",
        "description": "When the event was created, in UTC with milliseconds."
      }
    },
    "empty_fields": {
      "elements_chain": "PostHog derives it from `$elements_chain`, which no event declares; no sender sets it.",
      "url": "PostHog derives it from `$current_url`, which no event declares; no sender sets it."
    }
  },
  "common_properties": {
    "schema": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 1,
      "description": "The version of this event schema the event follows."
    },
    "tool": {
      "type": "enum",
      "required": true,
      "values": [
        "pipelex",
        "plxt",
        "vscode-pipelex",
        "mthds"
      ],
      "description": "The reporting tool."
    },
    "tool_version": {
      "type": "pattern",
      "required": true,
      "pattern": "release_version",
      "description": "The reporting tool's released version."
    },
    "surface": {
      "type": "enum",
      "required": true,
      "values_by": {
        "property": "tool",
        "values": {
          "pipelex": [
            "pipelex",
            "pipelex-agent",
            "api",
            "python"
          ],
          "plxt": [
            "plxt"
          ],
          "vscode-pipelex": [
            "extension"
          ],
          "mthds": [
            "mthds",
            "mthds-agent"
          ]
        }
      },
      "description": "Which entry point of the tool sent the event; the values depend on `tool`."
    },
    "integration": {
      "type": "enum",
      "required": true,
      "values": [
        "cli",
        "python",
        "fastapi",
        "docker",
        "mcp",
        "n8n",
        "ci"
      ],
      "description": "The pipelex runtime's integration mode. Sent by pipelex only.",
      "when": {
        "property": "tool",
        "equals": "pipelex"
      }
    },
    "host": {
      "type": "enum",
      "required": false,
      "values": [
        "cocode",
        "mthds-agent",
        "other"
      ],
      "description": "The program of ours that embeds or spawns the tool, when one declares itself; absent otherwise."
    },
    "id_new": {
      "type": "boolean",
      "required": true,
      "description": "Whether this process created the installation identifier."
    },
    "os": {
      "type": "enum",
      "required": true,
      "values": [
        "linux",
        "darwin",
        "windows",
        "other"
      ],
      "description": "The operating system family."
    },
    "arch": {
      "type": "enum",
      "required": true,
      "values": [
        "x86_64",
        "arm64",
        "other"
      ],
      "description": "The processor architecture."
    },
    "language_runtime": {
      "type": "pattern",
      "required": false,
      "pattern": "language_runtime",
      "description": "The language runtime the tool runs on, for the tools that run on one."
    },
    "ci": {
      "type": "boolean",
      "required": true,
      "description": "Whether the process runs in continuous integration, by the rule of the CI section."
    },
    "container": {
      "type": "boolean",
      "required": true,
      "description": "Whether the process runs in a container, by the rule of the container section."
    },
    "internal": {
      "type": "boolean",
      "required": true,
      "description": "Whether the shared state marks the machine as one of the team's."
    },
    "notice_version": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 1,
      "description": "The highest notice version recorded as shown on this machine, 0 when none."
    }
  },
  "events": {
    "run_completed": {
      "description": "One per run, whatever started it and however it ended.",
      "tools": [
        "pipelex"
      ],
      "common": true,
      "person_profile": "never",
      "properties": {
        "outcome": {
          "type": "enum",
          "required": true,
          "values": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "description": "How the run ended."
        },
        "error_domain": {
          "type": "enum",
          "required": true,
          "values": [
            "input",
            "config",
            "runtime",
            "other"
          ],
          "description": "For a failed run, who can fix the error, `other` when the runtime cannot say.",
          "when": {
            "property": "outcome",
            "equals": "failed"
          }
        },
        "dry_run": {
          "type": "boolean",
          "required": true,
          "description": "Whether the run was a dry run."
        },
        "method_source": {
          "type": "enum",
          "required": true,
          "values": [
            "local_bundle",
            "inline_source",
            "installed_method",
            "published_address",
            "catalog_id",
            "other"
          ],
          "description": "Where the method came from, by kind only."
        },
        "duration_ms": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 2592000000,
          "description": "The run's wall-clock duration in milliseconds."
        },
        "bundle_pipes": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 100000,
          "description": "The number of pipes the run's bundle declares."
        },
        "bundle_concepts": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 100000,
          "description": "The number of concepts the run's bundle declares."
        },
        "bundle_depth": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000,
          "description": "The deepest nesting of controllers under the run's main pipe."
        },
        "feature_batch": {
          "type": "boolean",
          "required": true,
          "description": "Whether the bundle uses batching."
        },
        "feature_parallel": {
          "type": "boolean",
          "required": true,
          "description": "Whether the bundle uses parallel branches."
        },
        "feature_condition": {
