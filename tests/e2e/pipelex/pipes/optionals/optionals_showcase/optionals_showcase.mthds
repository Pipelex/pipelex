domain      = "opt_showcase"
description = "Optionals showcase: lift chain, continue condition, absorbing sink, force flow"
main_pipe   = "oshow_main_flow"

[pipe.oshow_analyze_clause]
type          = "PipeFunc"
description   = "Analyzes the clause (plain input: lifts when clause is absent)"
inputs        = { clause = "Text" }
output        = "Text"
function_name = "oshow_analyze_clause"

[pipe.oshow_summarize_analysis]
type          = "PipeFunc"
description   = "Summarizes the analysis (plain input: chained lift)"
inputs        = { analysis = "Text" }
output        = "Text"
function_name = "oshow_summarize_analysis"

[pipe.oshow_flag_risk]
type          = "PipeFunc"
description   = "Produces the risk note for a flagged contract"
inputs        = { contract = "Text" }
output        = "Text"
function_name = "oshow_flag_risk"

[pipe.oshow_assess_risk]
type                = "PipeCondition"
description         = "Flags a risk when the contract mentions a penalty; otherwise continues"
inputs              = { contract = "Text" }
output              = "Text?"
expression_template = "{{ 'flagged' if 'penalty' in contract.text else 'clean' }}"
default_outcome     = "continue"

[pipe.oshow_assess_risk.outcomes]
flagged = "oshow_flag_risk"

[pipe.oshow_compose_report]
type = "PipeCompose"
description = "Absorbing sink: composes the report whether or not the optional slots resolved"
inputs = { contract = "Text", clause_summary = "Text?", risk_note = "Text?" }
output = "Text"
template = """
Report for: $contract
@?clause_summary
{% if risk_note is defined %}Risk: {{ risk_note.text }}{% else %}No risk assessment.{% endif %}
"""

[pipe.oshow_main_flow]
type = "PipeSequence"
description = "Lift chain + continue condition + absorbing sink delivering a guaranteed report"
inputs = { contract = "Text", clause = "Text?" }
output = "Text"
steps = [
  { pipe = "oshow_analyze_clause", result = "analysis" },
  { pipe = "oshow_summarize_analysis", result = "clause_summary" },
  { pipe = "oshow_assess_risk", result = "risk_note" },
  { pipe = "oshow_compose_report", result = "report" },
]

# The force flow is nested on purpose: the method boundary seeds the NOT_PROVIDED record for the
# `?` input, then the inner step's `!` marker asserts presence and raises the typed error.
[pipe.oshow_force_extract]
type          = "PipeFunc"
description   = "Asserts presence of the clause with a force marker"
inputs        = { clause = "Text!" }
output        = "Text"
function_name = "oshow_force_extract"

[pipe.oshow_force_flow]
type        = "PipeSequence"
description = "Force flow: optional at the boundary, asserted inside"
inputs      = { clause = "Text?" }
output      = "Text"
steps       = [{ pipe = "oshow_force_extract", result = "extracted" }]

[pipe.oshow_lift_only_flow]
type = "PipeSequence"
description = "Whole chain lifts when clause is absent; output declared optional"
inputs = { clause = "Text?" }
output = "Text?"
steps = [
  { pipe = "oshow_analyze_clause", result = "analysis" },
  { pipe = "oshow_summarize_analysis", result = "clause_summary" },
]
