domain      = "smart_inputs_demo"
description = "Bare caller values shaped top-down against the declared signature (Smart Inputs, Phase 2)"
main_pipe   = "triage_case"

[concept.Question]
description = "A question posed to the triage desk"
refines     = "Text"

[concept.Priority]
description = "A numeric priority score"
refines     = "Number"

[concept.Tag]
description = "A short routing label"
refines     = "Text"

[concept.Invoice]
description = "An invoice attached to the case"

[concept.Invoice.structure]
invoice_number = { type = "text", description = "The invoice number", required = true }
amount         = { type = "number", description = "The invoice amount", required = true }

[pipe.triage_case]
type = "PipeLLM"
description = "Triage a case given a bare question, priority, invoice and tags"
inputs = { question = "Question", priority = "Priority", invoice = "Invoice", tags = "Tag[]" }
output = "Text"
prompt = """
Question: $question
Priority: $priority
Invoice number: {{ invoice.invoice_number }} for {{ invoice.amount }}
Tags:
@tags

Write a one-line triage summary.
"""
