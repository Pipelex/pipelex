domain      = "offline_manifold_img_gen"
description = "Pipeline referencing a manifold image-generation model that exists in the cached manifold specs"
main_pipe   = "manifold_img_gen_pipe"

[pipe]
[pipe.manifold_img_gen_pipe]
type        = "PipeImgGen"
description = "Single image-generation step using a manifold-listed image model handle"
output      = "Image"
model       = "gpt-image-2"
prompt      = "A single red circle on a white background."
